{
  "schemaVersion": 2,
  "type": "pi-forge.prompt-stack",
  "id": "read-first-worker",
  "name": "Read-first Worker",
  "autoActivate": false,
  "mode": "replace",
  "tools": {
    "allow": [
      "read",
      "ls",
      "forge_capability",
      "bash",
      "edit"
    ],
    "initial": [
      "read",
      "ls",
      "forge_capability"
    ]
  },
  "capabilities": [
    {
      "id": "write-tools",
      "ref": "project:write-tools",
      "modelCallable": true
    }
  ],
  "items": [
    {
      "kind": "block",
      "id": "worker-role",
      "name": "Worker Role",
      "enabled": true,
      "role": "system",
      "content": "You are a helpful software engineer assistant. Discover paths with ls then read. When the task needs shell commands or edits, use forge_capability with the enable action for the write-tools binding, then use its disable action when finished."
    },
    {
      "kind": "slot",
      "id": "chat-history",
      "name": "Chat History",
      "enabled": true,
      "slot": "chat-history",
      "options": {
        "includeSummaries": false
      }
    }
  ]
}
