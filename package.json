{
  "name": "@zihanw/pi-forge",
  "version": "0.4.0-beta.1",
  "description": "Pi extension for prompt stacks, one-shot agent profiles, policy, import, and debugging.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MacroSony/pi-forge.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./subagent": {
      "types": "./dist/subagent/index.d.ts",
      "import": "./dist/subagent/index.js",
      "default": "./dist/subagent/index.js"
    },
    "./src/*.ts": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./src/*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./src/*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./examples/*": "./examples/*"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "prompt-stack",
    "agent-profile"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "0.82.1",
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "dependencies": {
    "@earendil-works/pi-tui": "0.82.1",
    "@zihanw/pi-subagent-runtime": "0.1.0-beta.1",
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.82.1",
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@types/node": "22.20.1",
    "@vitejs/plugin-vue": "6.0.8",
    "playwright-core": "1.61.1",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vue": "3.5.40",
    "vue-tsc": "3.3.8"
  },
  "scripts": {
    "build": "npm run build:client && tsc -p tsconfig.build.json",
    "build:client": "node scripts/build-web-client.mjs",
    "check:client": "node scripts/build-web-client.mjs --check",
    "check:dist": "node scripts/check-dist.mjs",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p tsconfig.web.json",
    "test": "node --test tests/*.test.ts",
    "test:browser": "node --test tests-browser/*.test.ts",
    "verify": "npm test && npm run test:browser && npm run typecheck && npm run check:client && npm run check:dist && npm run check:package"
  },
  "files": [
    "dist/",
    "examples/",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "SUBAGENT_ADAPTER_CONTRACT.md",
    "PUBLIC_API.md",
    "LICENSE*"
  ],
  "publishConfig": {
    "access": "public"
  }
}
